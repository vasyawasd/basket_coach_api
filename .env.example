# Copy to .env (or API.env) and set your keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Primary OpenAI-compatible LLM provider (any aggregator works)
CLAUDEHUB_API_KEY=your_claudehub_api_key_here
CLAUDEHUB_BASE_URL=https://api.claudehub.fun/v1

# 'budget' = auto-cascade starts from cheap models (default), 'premium' = from flagship
LLM_AUTO_STRATEGY=budget

# Daily plan quotas (protect the LLM API budget)
ANON_DAILY_LIMIT=3
USER_DAILY_LIMIT=15

# Admin metrics token (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
# When unset, /api/admin/stats is disabled
ADMIN_TOKEN=

# Set to 1 only behind a reverse proxy (nginx/Caddy) so client IPs resolve correctly
TRUSTED_PROXY=
